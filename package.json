{
  "name": "braid",
  "displayName": "Braid — Git Graph",
  "description": "A fast, read-only Git commit graph for VS Code.",
  "version": "0.0.1",
  "publisher": "HouseAlwaysWin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "log",
    "commit"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:braid.graph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "braid.openGraph",
        "title": "Open Git Graph",
        "category": "Braid",
        "icon": "$(git-branch)"
      },
      {
        "command": "braid.refresh",
        "title": "Refresh",
        "category": "Braid",
        "icon": "$(refresh)"
      },
      {
        "command": "braid.showGitLog",
        "title": "Show Git Command Log",
        "category": "Braid"
      },
      {
        "command": "braid.showAllRefs",
        "title": "Show All Branches & Tags",
        "category": "Braid",
        "icon": "$(clear-all)"
      },
      {
        "command": "braid.stash",
        "title": "Stash Changes",
        "category": "Braid",
        "icon": "$(archive)"
      },
      {
        "command": "braid.filterRefs",
        "title": "Filter Branches & Tags…",
        "category": "Braid",
        "icon": "$(filter)"
      },
      {
        "command": "braid.showAllAuthors",
        "title": "Show All Authors",
        "category": "Braid",
        "icon": "$(clear-all)"
      },
      {
        "command": "braid.clearFilters",
        "title": "Clear All Filters",
        "category": "Braid",
        "icon": "$(clear-all)"
      },
      {
        "command": "braid.filesAsTree",
        "title": "View Changed Files as Tree",
        "category": "Braid",
        "icon": "$(list-tree)"
      },
      {
        "command": "braid.filesAsList",
        "title": "View Changed Files as List",
        "category": "Braid",
        "icon": "$(list-flat)"
      },
      {
        "command": "braid.openCommitFile",
        "title": "Open Changes",
        "category": "Braid"
      },
      {
        "command": "braid.fetch",
        "title": "Fetch",
        "category": "Braid",
        "icon": "$(cloud-download)"
      },
      {
        "command": "braid.pull",
        "title": "Pull",
        "category": "Braid",
        "icon": "$(arrow-down)"
      },
      {
        "command": "braid.push",
        "title": "Push",
        "category": "Braid",
        "icon": "$(arrow-up)"
      },
      {
        "command": "braid.pushForce",
        "title": "Force Push (with lease)",
        "category": "Braid"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "braid.openGraph",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "braid.openCommitFile",
          "when": "false"
        },
        {
          "command": "braid.refresh",
          "when": "braid.graphVisible"
        },
        {
          "command": "braid.stash",
          "when": "braid.graphVisible"
        },
        {
          "command": "braid.fetch",
          "when": "braid.graphVisible"
        },
        {
          "command": "braid.pull",
          "when": "braid.graphVisible"
        },
        {
          "command": "braid.push",
          "when": "braid.graphVisible"
        },
        {
          "command": "braid.pushForce",
          "when": "braid.graphVisible"
        }
      ],
      "editor/title": [
        {
          "command": "braid.fetch",
          "when": "activeWebviewPanelId == braid.graph",
          "group": "navigation@1"
        },
        {
          "command": "braid.pull",
          "when": "activeWebviewPanelId == braid.graph",
          "group": "navigation@2"
        },
        {
          "command": "braid.push",
          "when": "activeWebviewPanelId == braid.graph",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "braid.filterRefs",
          "when": "view == braid.refs",
          "group": "navigation@1"
        },
        {
          "command": "braid.showAllRefs",
          "when": "view == braid.refs",
          "group": "navigation@2"
        },
        {
          "command": "braid.openGraph",
          "when": "view == braid.refs",
          "group": "navigation@3"
        },
        {
          "command": "braid.showAllAuthors",
          "when": "view == braid.authors",
          "group": "navigation@1"
        },
        {
          "command": "braid.filesAsList",
          "when": "view == braid.files && braid.filesAsTree",
          "group": "navigation@1"
        },
        {
          "command": "braid.filesAsTree",
          "when": "view == braid.files && !braid.filesAsTree",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Braid",
      "properties": {
        "braid.pageSize": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 20000,
          "markdownDescription": "How many commits to load per page. The first page is what you wait for on open."
        },
        "braid.rowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 16,
          "maximum": 48,
          "description": "Height of a single commit row, in pixels."
        },
        "braid.maxConcurrentGitProcesses": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Upper bound on git processes Braid runs at once."
        },
        "braid.refreshDebounceMs": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 5000,
          "description": "Quiet period after repository changes before the graph reloads."
        },
        "braid.authorColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each author their own colour in the commit list. Always off in high contrast themes."
        },
        "braid.networkIdleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "Give up on a fetch, pull or push after this many seconds with **no output at all**. This is idle time, not total time, so a slow but live transfer is never cut off. `0` waits forever."
        },
        "braid.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Braid button in the status bar when the workspace has a git repository."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "braid.files",
          "name": "Commit Files",
          "icon": "media/braid.svg",
          "contextualTitle": "Braid",
          "visibility": "collapsed",
          "when": "braid.hasRepository"
        },
        {
          "id": "braid.refs",
          "name": "Branches & Tags",
          "icon": "media/braid.svg",
          "contextualTitle": "Braid",
          "visibility": "collapsed",
          "when": "braid.hasRepository"
        },
        {
          "id": "braid.authors",
          "name": "Authors",
          "icon": "media/braid.svg",
          "contextualTitle": "Braid",
          "visibility": "collapsed",
          "when": "braid.hasRepository"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"test/**/*.test.ts\" && node scripts/color-check.mjs && node scripts/load-check.mjs --watch && node scripts/load-check.mjs --break-view=braid.files",
    "vscode:prepublish": "node esbuild.mjs --production",
    "smoke": "node scripts/smoke.mjs",
    "load-check": "node scripts/load-check.mjs",
    "package": "vsce package --no-dependencies",
    "icon-check": "node scripts/icon-check.mjs",
    "color-check": "node scripts/color-check.mjs",
    "test:unit": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "@vscode/vsce": "^3.6.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Braid runs the git CLI, which honours repository-local configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Braid needs a real filesystem and a local git executable."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HouseAlwaysWin/Braid.git"
  }
}
