{
  "name": "git-weft",
  "displayName": "Git Weft",
  "description": "A fast, read-only Git commit graph for VS Code.",
  "version": "0.0.1",
  "publisher": "HouseAlwaysWin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "log",
    "commit"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:weft.graph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "weft.openGraph",
        "title": "Open Git Graph",
        "category": "Git Weft",
        "icon": "$(git-branch)"
      },
      {
        "command": "weft.refresh",
        "title": "Refresh",
        "category": "Git Weft",
        "icon": "$(refresh)"
      },
      {
        "command": "weft.showGitLog",
        "title": "Show Git Command Log",
        "category": "Git Weft"
      },
      {
        "command": "weft.showAllRefs",
        "title": "Show All Branches & Tags",
        "category": "Git Weft",
        "icon": "$(clear-all)"
      },
      {
        "command": "weft.stash",
        "title": "Stash Changes",
        "category": "Git Weft",
        "icon": "$(archive)"
      },
      {
        "command": "weft.filterRefs",
        "title": "Filter Branches & Tags…",
        "category": "Git Weft",
        "icon": "$(filter)"
      },
      {
        "command": "weft.showAllAuthors",
        "title": "Show All Authors",
        "category": "Git Weft",
        "icon": "$(clear-all)"
      },
      {
        "command": "weft.checkoutRef",
        "title": "Checkout",
        "category": "Git Weft"
      },
      {
        "command": "weft.showOnlyRef",
        "title": "Show Only This",
        "category": "Git Weft"
      },
      {
        "command": "weft.showOnlyListedRefs",
        "title": "Show Only What Is Listed",
        "category": "Git Weft",
        "icon": "$(filter-filled)"
      },
      {
        "command": "weft.clearFilters",
        "title": "Clear All Filters",
        "category": "Git Weft",
        "icon": "$(clear-all)"
      },
      {
        "command": "weft.filesAsTree",
        "title": "View Changed Files as Tree",
        "category": "Git Weft",
        "icon": "$(list-tree)"
      },
      {
        "command": "weft.filesAsList",
        "title": "View Changed Files as List",
        "category": "Git Weft",
        "icon": "$(list-flat)"
      },
      {
        "command": "weft.openCommitFile",
        "title": "Open Changes",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyRefName",
        "title": "Copy Name",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyFullRefName",
        "title": "Copy Full Ref Name",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyFilePath",
        "title": "Copy Path",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyAbsoluteFilePath",
        "title": "Copy Absolute Path",
        "category": "Git Weft"
      },
      {
        "command": "weft.showFileHistory",
        "title": "Show File History",
        "category": "Git Weft",
        "icon": "$(history)"
      },
      {
        "command": "weft.fetch",
        "title": "Fetch",
        "category": "Git Weft",
        "icon": "$(cloud-download)"
      },
      {
        "command": "weft.pull",
        "title": "Pull",
        "category": "Git Weft",
        "icon": "$(arrow-down)"
      },
      {
        "command": "weft.push",
        "title": "Push",
        "category": "Git Weft",
        "icon": "$(arrow-up)"
      },
      {
        "command": "weft.pushForce",
        "title": "Force Push (with lease)",
        "category": "Git Weft"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "weft.openGraph",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "weft.openCommitFile",
          "when": "false"
        },
        {
          "command": "weft.showFileHistory",
          "when": "false"
        },
        {
          "command": "weft.copyRefName",
          "when": "false"
        },
        {
          "command": "weft.copyFullRefName",
          "when": "false"
        },
        {
          "command": "weft.copyFilePath",
          "when": "false"
        },
        {
          "command": "weft.copyAbsoluteFilePath",
          "when": "false"
        },
        {
          "command": "weft.checkoutRef",
          "when": "false"
        },
        {
          "command": "weft.showOnlyRef",
          "when": "false"
        },
        {
          "command": "weft.showOnlyListedRefs",
          "when": "weft.refsListFiltered"
        },
        {
          "command": "weft.refresh",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.stash",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.fetch",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.pull",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.push",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.pushForce",
          "when": "weft.graphVisible"
        }
      ],
      "editor/title": [
        {
          "command": "weft.fetch",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@1"
        },
        {
          "command": "weft.pull",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@2"
        },
        {
          "command": "weft.push",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "weft.showFileHistory",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "navigation@1"
        },
        {
          "command": "weft.copyFilePath",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "copy@1"
        },
        {
          "command": "weft.copyAbsoluteFilePath",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "copy@2"
        },
        {
          "command": "weft.copyRefName",
          "when": "view == weft.refs && viewItem == weftRef",
          "group": "copy@1"
        },
        {
          "command": "weft.copyFullRefName",
          "when": "view == weft.refs && viewItem == weftRef",
          "group": "copy@2"
        },
        {
          "command": "weft.checkoutRef",
          "when": "view == weft.refs && viewItem == weftRef",
          "group": "navigation@1"
        },
        {
          "command": "weft.showOnlyRef",
          "when": "view == weft.refs && viewItem == weftRef",
          "group": "filter@1"
        },
        {
          "command": "weft.showAllRefs",
          "when": "view == weft.refs && viewItem == weftRef",
          "group": "filter@2"
        }
      ],
      "view/title": [
        {
          "command": "weft.filterRefs",
          "when": "view == weft.refs",
          "group": "navigation@1"
        },
        {
          "command": "weft.showOnlyListedRefs",
          "when": "view == weft.refs && weft.refsListFiltered",
          "group": "navigation@2"
        },
        {
          "command": "weft.showAllRefs",
          "when": "view == weft.refs",
          "group": "navigation@2"
        },
        {
          "command": "weft.openGraph",
          "when": "view == weft.refs",
          "group": "navigation@3"
        },
        {
          "command": "weft.showAllAuthors",
          "when": "view == weft.authors",
          "group": "navigation@1"
        },
        {
          "command": "weft.filesAsList",
          "when": "view == weft.files && weft.filesAsTree",
          "group": "navigation@1"
        },
        {
          "command": "weft.filesAsTree",
          "when": "view == weft.files && !weft.filesAsTree",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Weft",
      "properties": {
        "weft.pageSize": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 20000,
          "markdownDescription": "How many commits to load per page. The first page is what you wait for on open."
        },
        "weft.rowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 16,
          "maximum": 48,
          "description": "Height of a single commit row, in pixels."
        },
        "weft.maxConcurrentGitProcesses": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Upper bound on git processes Weft runs at once."
        },
        "weft.refreshDebounceMs": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 5000,
          "description": "Quiet period after repository changes before the graph reloads."
        },
        "weft.authorColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each author their own colour in the commit list. Always off in high contrast themes."
        },
        "weft.networkIdleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "Give up on a fetch, pull or push after this many seconds with **no output at all**. This is idle time, not total time, so a slow but live transfer is never cut off. `0` waits forever."
        },
        "weft.autoFetchMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "markdownDescription": "Fetch from every remote this often, in minutes. `0` never fetches on its own.\n\nA remote-tracking ref like `origin/main` only moves when something fetches, so the graph - and the ahead/behind counts beside the title - are only ever as current as the last fetch. Weft picks up whatever moves them, including VS Code's own `#git.autofetch#`, so turn this on only if you would rather Weft did it."
        },
        "weft.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Weft button in the status bar when the workspace has a git repository."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "weft.files",
          "name": "Commit Files",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        },
        {
          "id": "weft.refs",
          "name": "Branches & Tags",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        },
        {
          "id": "weft.authors",
          "name": "Authors",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"test/**/*.test.ts\" && node scripts/color-check.mjs && node scripts/load-check.mjs --watch && node scripts/load-check.mjs --break-view=weft.files",
    "vscode:prepublish": "node esbuild.mjs --production",
    "smoke": "node scripts/smoke.mjs",
    "load-check": "node scripts/load-check.mjs",
    "package": "vsce package --no-dependencies",
    "icon-check": "node scripts/icon-check.mjs",
    "color-check": "node scripts/color-check.mjs",
    "test:unit": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "@vscode/vsce": "^3.6.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Weft runs the git CLI, which honours repository-local configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Weft needs a real filesystem and a local git executable."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HouseAlwaysWin/Git-Weft.git"
  }
}
